{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "i-daily",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-07-01",
	// nodejs_compat: shared/model·report 등에서 node 내장(예: Buffer/crypto) 사용 대비.
	"compatibility_flags": [
		"nodejs_compat"
	],
	// D1: better-sqlite3 대체. database_id 는 `wrangler d1 create i-daily` 후 채운다.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "i-daily",
			"database_id": "202700f9-e453-47a5-a4ee-65831d27416b",
			"migrations_dir": "./migrations"
		}
	],
	// 빌드된 React SPA(정적) 서빙.
	// run_worker_first: /api · MCP/OAuth · auth UI 는 SPA fallback 보다 워커 우선.
	"assets": {
		"directory": "./dist/web",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/mcp",
			"/mcp/*",
			"/register",
			"/authorize",
			"/token",
			"/userinfo",
			"/revoke",
			"/introspect",
			"/sign-in",
			"/consent",
			"/.well-known/*"
		]
	},
	"observability": {
		"enabled": true
	}
}
