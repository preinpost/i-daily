# 로컬 wrangler dev 용 secrets (.dev.vars 로 복사해 채우세요 — 커밋 금지).
# 배포는 `wrangler secret put <NAME>` 로 등록(원격 Workers 에 적용).

# Atlassian OAuth 2.0 (3LO) 클라이언트 — developer.atlassian.com/myapps 에서 발급.
# 앱의 Callback URL 을 아래 JIRA_REDIRECT_URI 와 똑같이 등록해야 함.
#  - 운영: https://i-daily.<your-subdomain>.workers.dev/api/jira/callback
#  - 로컬 dev: http://localhost:5173/api/jira/callback  (← 반드시 앱 오리진=vite 5173)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# OAuth 콜백 URL 고정. 로컬 dev 에서는 반드시 앱 오리진(vite 5173)으로 지정!
# 이유: 콜백이 앱과 같은 오리진으로 돌아와야(vite 프록시 → /api → wrangler)
# 세션 쿠키(sid)가 앱에 저장되고 postMessage 로 로그인 완료를 알릴 수 있다.
# 127.0.0.1:8787 로 두면 쿠키가 다른 오리진에 저장되어 “연동 안됨” 으로 보인다.
# (레거시) JIRA_REDIRECT_URI — Better Auth 전환 후 콜백은 /api/auth/callback/atlassian
JIRA_REDIRECT_URI=http://localhost:5173/api/jira/callback

# Better Auth (웹 세션 + MCP OAuth AS). 운영은 wrangler secret.
# 로컬은 Vite 오리진(5173) — 프록시로 /api·/.well-known → 8787.
# Atlassian 앱 Callback URL 에 추가:
#   http://localhost:5173/api/auth/callback/atlassian
#   https://i-daily.<subdomain>.workers.dev/api/auth/callback/atlassian
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=dev-secret-at-least-32-characters-long!!

# Microsoft Entra ID (Azure AD) — Graph 보조 연결(로그인 대체 아님).
# portal.azure.com → App registrations → New registration
#  - Supported account types: 조직 디렉터리(단일/다중) 권장
#  - Redirect URI (Web):
#      http://localhost:5173/api/auth/callback/microsoft
#      https://i-daily.<subdomain>.workers.dev/api/auth/callback/microsoft
#  - Certificates & secrets → client secret
#  - API permissions (Delegated): User.Read 만으로 연결 테스트 가능
#      (openid/profile/email/offline_access 는 BA 기본 요청)
#  - Excel/Teams 는 나중에 MICROSOFT_EXTRA_SCOPES + Azure 권한 동시 추가
#  - 회사 테넌트가 사용자 동의를 막으면 User.Read 만으로도 관리자 승인 필요
# MICROSOFT_TENANT_ID: 테넌트 GUID | organizations(기본) | common | consumers
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations

# (선택) config 초기값 — 공개 배포 시 비움. user 가 설정 탭에서 덮어씀.
# OWNER=
# JIRA_BASE=
